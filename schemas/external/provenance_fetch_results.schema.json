{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathsciencecompendium.local/schemas/external/provenance_fetch_results.schema.json",
  "title": "ExternalFetchProvenance",
  "type": "object",
  "required": ["generated_at_utc", "manifest", "results"],
  "properties": {
    "generated_at_utc": { "type": "string", "format": "date-time" },
    "manifest": { "type": "string", "minLength": 1 },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "target_relpath",
          "status",
          "fetched_at_utc",
          "notes"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "target_relpath": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "minLength": 1 },
          "source_url": { "type": ["string", "null"] },
          "size_bytes": { "type": ["integer", "null"], "minimum": 0 },
          "sha256": { "type": ["string", "null"], "pattern": "^([a-f0-9]{64})?$" },
          "extract_text_relpath": { "type": ["string", "null"] },
          "fetched_at_utc": { "type": "string", "format": "date-time" },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
