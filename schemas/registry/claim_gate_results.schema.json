{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathsciencecompendium.local/schemas/registry/claim_gate_results.schema.json",
  "title": "ClaimGateResults",
  "type": "object",
  "required": ["schema_version", "generator", "claim_count", "gate_count", "consistent_count", "inconsistent_count", "all_contracts_consistent", "results"],
  "properties": {
    "schema_version": {"const": 1},
    "generator": {"const": "scripts/run_claim_gates.py"},
    "claim_count": {"type": "integer", "minimum": 1},
    "gate_count": {"type": "integer", "minimum": 1},
    "consistent_count": {"type": "integer", "minimum": 0},
    "inconsistent_count": {"type": "integer", "minimum": 0},
    "all_contracts_consistent": {"type": "boolean"},
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim_id", "checker", "gate_kind", "expected_claim_status", "actual_claim_status", "expected_gate_outcome", "actual_gate_outcome", "registry_consistent", "scientific_outcome", "missing_evidence_paths", "summary", "metrics"],
        "properties": {
          "claim_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "checker": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "gate_kind": {"type": "string", "minLength": 1},
          "expected_claim_status": {"type": "string", "minLength": 1},
          "actual_claim_status": {"type": "string", "minLength": 1},
          "expected_gate_outcome": {"type": "string", "minLength": 1},
          "actual_gate_outcome": {"type": "string", "minLength": 1},
          "registry_consistent": {"type": "boolean"},
          "scientific_outcome": {"enum": ["accepted", "corrected", "bounded", "open", "rejected", "falsified", "repaired", "excluded"]},
          "missing_evidence_paths": {"type": "array", "items": {"type": "string"}},
          "summary": {"type": "string", "minLength": 1},
          "metrics": {"type": "object"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
