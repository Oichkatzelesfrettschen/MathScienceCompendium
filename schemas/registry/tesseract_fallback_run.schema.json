{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "generator",
    "quality_audit_relpath",
    "quality_audit_sha256",
    "engine_version",
    "dpi",
    "page_segmentation_mode",
    "document_count",
    "page_count",
    "documents"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "generator": {"const": "scripts/run_tesseract_fallbacks.py"},
    "quality_audit_relpath": {"type": "string", "minLength": 1},
    "quality_audit_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "engine_version": {"type": "string", "minLength": 1},
    "dpi": {"type": "integer", "minimum": 1},
    "page_segmentation_mode": {"type": "integer", "minimum": 0},
    "document_count": {"type": "integer", "minimum": 0},
    "page_count": {"type": "integer", "minimum": 0},
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_relpath",
          "source_sha256",
          "selected_pages",
          "manifest_relpath",
          "manifest_sha256"
        ],
        "properties": {
          "source_relpath": {"type": "string", "pattern": "\\.pdf$"},
          "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "selected_pages": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "integer", "minimum": 1}
          },
          "manifest_relpath": {"type": "string", "pattern": "manifest\\.json$"},
          "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
