{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathsciencecompendium.local/schemas/registry/claim_source_crosswalk.schema.json",
  "title": "ClaimSourceCrosswalkRegistry",
  "type": "object",
  "required": ["generated_by", "generated_at_utc", "description", "coverage_policy", "claims"],
  "properties": {
    "generated_by": { "type": "string", "minLength": 1 },
    "generated_at_utc": { "type": "string", "format": "date-time" },
    "description": { "type": "string", "minLength": 1 },
    "coverage_policy": {
      "type": "object",
      "required": [
        "min_claims_per_chapter",
        "min_unique_sources_per_chapter",
        "required_chapter_group_prefixes",
        "min_claims_per_group",
        "min_unique_sources_per_group"
      ],
      "properties": {
        "min_claims_per_chapter": { "type": "integer", "minimum": 1 },
        "min_unique_sources_per_chapter": { "type": "integer", "minimum": 1 },
        "required_chapter_group_prefixes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "min_claims_per_group": { "type": "integer", "minimum": 1 },
        "min_unique_sources_per_group": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim_id", "chapter_relpath", "claim_anchor", "source_ids", "status"],
        "properties": {
          "claim_id": { "type": "string", "minLength": 1 },
          "chapter_relpath": { "type": "string", "minLength": 1 },
          "claim_anchor": { "type": "string", "minLength": 1 },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "status": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
