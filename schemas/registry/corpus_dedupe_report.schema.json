{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathsciencecompendium.local/schemas/registry/corpus_dedupe_report.schema.json",
  "title": "CorpusDedupeReportRegistry",
  "type": "object",
  "required": [
    "generated_by",
    "generated_at_utc",
    "registry_relpath",
    "documents_total",
    "exact_duplicate_groups",
    "exact_duplicate_documents",
    "hash_mismatch_count",
    "status",
    "reconciliation_actions"
  ],
  "properties": {
    "generated_by": { "type": "string", "minLength": 1 },
    "generated_at_utc": { "type": "string", "format": "date-time" },
    "registry_relpath": { "type": "string", "minLength": 1 },
    "documents_total": { "type": "integer", "minimum": 0 },
    "exact_duplicate_groups": { "type": "integer", "minimum": 0 },
    "exact_duplicate_documents": { "type": "integer", "minimum": 0 },
    "hash_mismatch_count": { "type": "integer", "minimum": 0 },
    "status": { "type": "string", "enum": ["clean", "attention_required"] },
    "reconciliation_actions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "hash_mismatches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "duplicate_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sha256",
          "count",
          "canonical_source_relpath",
          "recommended_action",
          "source_relpaths",
          "normalized_relpaths"
        ],
        "properties": {
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "count": { "type": "integer", "minimum": 2 },
          "canonical_source_relpath": { "type": "string", "minLength": 1 },
          "recommended_action": { "type": "string", "minLength": 1 },
          "source_relpaths": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "string", "minLength": 1 }
          },
          "normalized_relpaths": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
