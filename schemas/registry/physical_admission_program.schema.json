{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathsciencecompendium.local/schemas/registry/physical_admission_program.schema.json",
  "title": "PhysicalAdmissionProgram",
  "type": "object",
  "required": ["schema_version", "program_id", "description", "promotion_states", "raw_evidence_contract", "packages", "excluded_until_redefined"],
  "properties": {
    "schema_version": {"const": 1},
    "program_id": {"const": "physical_admission"},
    "description": {"type": "string", "minLength": 1},
    "promotion_states": {"const": ["specified", "calibrated", "blind_controls_complete", "energy_or_constraint_closure_passed", "multiplicity_corrected_effect_passed", "independently_replicated", "admitted"]},
    "raw_evidence_contract": {"type": "array", "minItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "packages": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["rank", "claim_id", "hypothesis_id", "current_state", "next_required_state", "operator_set", "locked_controls", "advance_rule", "blockers", "state_evidence"],
        "properties": {
          "rank": {"type": "integer", "minimum": 1, "maximum": 4},
          "claim_id": {"type": "string", "minLength": 1},
          "hypothesis_id": {"type": "string", "minLength": 1},
          "current_state": {"enum": ["specified", "calibrated", "blind_controls_complete", "energy_or_constraint_closure_passed", "multiplicity_corrected_effect_passed", "independently_replicated", "admitted"]},
          "next_required_state": {"enum": ["calibrated", "blind_controls_complete", "energy_or_constraint_closure_passed", "multiplicity_corrected_effect_passed", "independently_replicated", "admitted", "none"]},
          "operator_set": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}},
          "locked_controls": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}},
          "advance_rule": {"type": "string", "minLength": 1},
          "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "state_evidence": {
            "type": "object",
            "required": ["calibrated", "blind_controls_complete", "energy_or_constraint_closure_passed", "multiplicity_corrected_effect_passed", "independently_replicated", "admitted"],
            "properties": {
              "calibrated": {"$ref": "#/$defs/evidenceRecords"},
              "blind_controls_complete": {"$ref": "#/$defs/evidenceRecords"},
              "energy_or_constraint_closure_passed": {"$ref": "#/$defs/evidenceRecords"},
              "multiplicity_corrected_effect_passed": {"$ref": "#/$defs/evidenceRecords"},
              "independently_replicated": {"$ref": "#/$defs/evidenceRecords"},
              "admitted": {"$ref": "#/$defs/evidenceRecords"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "excluded_until_redefined": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object"}}
  },
  "$defs": {
    "evidenceRecords": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["relpath", "sha256"],
        "properties": {
          "relpath": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
