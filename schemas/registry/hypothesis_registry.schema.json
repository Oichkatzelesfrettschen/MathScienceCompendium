{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathsciencecompendium.local/schemas/registry/hypothesis_registry.schema.json",
  "title": "HypothesisRegistry",
  "type": "object",
  "required": [
    "schema_version",
    "description",
    "source_claim_statuses",
    "promotion_policy",
    "hypotheses",
    "archival_conjecture_dispositions"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "description": {"type": "string", "minLength": 1},
    "source_claim_statuses": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"enum": ["bounded", "excluded", "falsified", "unsupported"]}
    },
    "promotion_policy": {
      "type": "object",
      "required": [
        "paper_admission_rule",
        "independent_reproduction_rule",
        "literature_rule"
      ],
      "additionalProperties": false,
      "properties": {
        "paper_admission_rule": {"type": "string", "minLength": 1},
        "independent_reproduction_rule": {"type": "string", "minLength": 1},
        "literature_rule": {"type": "string", "minLength": 1}
      }
    },
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "program_id",
          "source_claim_ids",
          "formal_statement",
          "observable_predictions",
          "controls",
          "falsification_thresholds",
          "required_evidence",
          "implementation_status",
          "research_status",
          "literature_source_ids",
          "independent_reproduction",
          "paper_promotion"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^hyp_[a-z0-9_]+$"},
          "title": {"type": "string", "minLength": 1},
          "program_id": {
            "enum": [
              "e7_fourier_selector",
              "beta_plane_jets",
              "physical_admission",
              "foundational_backlog"
            ]
          },
          "source_claim_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}
          },
          "formal_statement": {"type": "string", "minLength": 1},
          "observable_predictions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "observable", "expected_relation", "measurement_method"],
              "additionalProperties": false,
              "properties": {
                "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
                "observable": {"type": "string", "minLength": 1},
                "expected_relation": {"type": "string", "minLength": 1},
                "measurement_method": {"type": "string", "minLength": 1}
              }
            }
          },
          "controls": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "falsification_thresholds": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "required_evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["kind", "description", "status", "artifact_paths"],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": [
                    "definition",
                    "derivation",
                    "simulation",
                    "measurement",
                    "control",
                    "literature",
                    "replication"
                  ]
                },
                "description": {"type": "string", "minLength": 1},
                "status": {
                  "enum": ["present", "planned", "missing", "external_required"]
                },
                "artifact_paths": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {"type": "string", "minLength": 1}
                }
              }
            }
          },
          "implementation_status": {
            "enum": [
              "design_only",
              "implemented_unrun",
              "implemented_negative",
              "implemented_inconclusive",
              "implemented_supported",
              "blocked_external_evidence",
              "excluded_undefined"
            ]
          },
          "research_status": {"enum": ["active", "blocked", "excluded", "falsified"]},
          "literature_source_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "independent_reproduction": {
            "type": "object",
            "required": ["required", "status", "evidence_paths"],
            "additionalProperties": false,
            "properties": {
              "required": {"type": "boolean"},
              "status": {"enum": ["pending", "passed", "failed", "not_applicable"]},
              "evidence_paths": {
                "type": "array",
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              }
            }
          },
          "paper_promotion": {"enum": ["prohibited", "pending", "eligible", "promoted"]}
        }
      }
    },
    "archival_conjecture_dispositions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_relpath", "authority", "items"],
        "additionalProperties": false,
        "properties": {
          "source_relpath": {"type": "string", "minLength": 1},
          "authority": {"const": "archival_only"},
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "locator", "title", "disposition", "mapped_hypothesis_ids", "rationale"],
              "additionalProperties": false,
              "properties": {
                "id": {"type": "string", "pattern": "^legacy_[a-z0-9_]+$"},
                "locator": {"type": "string", "minLength": 1},
                "title": {"type": "string", "minLength": 1},
                "disposition": {"enum": ["mapped", "superseded", "field_open_problem", "excluded_undefined"]},
                "mapped_hypothesis_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^hyp_[a-z0-9_]+$"}},
                "rationale": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
