{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathsciencecompendium.local/schemas/registry/beta_plane_sweep_results.schema.json",
  "title": "BetaPlaneSweepResults",
  "type": "object",
  "required": ["schema_version", "generator", "profile", "scientifically_admissible_profile", "preregistration_relpath", "preregistration_sha256", "source_commit", "environment_lock_relpath", "environment_lock_sha256", "evidence_archive", "run_count", "records", "primary_contrasts", "numerical_gate_passed", "primary_hypothesis_passed", "aggregate_decision", "claim_scope"],
  "properties": {
    "schema_version": {"const": 1},
    "generator": {"const": "scripts/run_beta_plane_sweep.py"},
    "profile": {"const": "production"},
    "scientifically_admissible_profile": {"const": true},
    "preregistration_relpath": {"const": "data/registry/beta_plane_sweep_preregistration.json"},
    "preregistration_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "environment_lock_relpath": {"const": "requirements-lock.txt"},
    "environment_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution_receipt": {
      "type": "object",
      "required": ["fresh_execution_required", "work_root_existed_before", "resumed_count", "pending_count", "total_count"],
      "additionalProperties": false,
      "properties": {
        "fresh_execution_required": {"type": "boolean"},
        "work_root_existed_before": {"type": "boolean"},
        "resumed_count": {"type": "integer", "minimum": 0},
        "pending_count": {"type": "integer", "minimum": 0},
        "total_count": {"type": "integer", "minimum": 1}
      }
    },
    "evidence_archive": {
      "type": "object",
      "required": ["relpath", "sha256", "format"],
      "properties": {
        "relpath": {"const": "data/evidence/beta_plane/production_run_arrays.tar"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "format": {"const": "deterministic_uncompressed_tar_of_npz"}
      },
      "additionalProperties": false
    },
    "run_count": {"const": 540},
    "records": {"type": "array", "minItems": 540, "maxItems": 540, "items": {"type": "object"}},
    "primary_contrasts": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"type": "object"}},
    "numerical_gate_passed": {"type": "boolean"},
    "primary_hypothesis_passed": {"type": "boolean"},
    "aggregate_decision": {"enum": ["primary_supported_pending_refinement_and_reproduction", "not_supported"]},
    "claim_scope": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
