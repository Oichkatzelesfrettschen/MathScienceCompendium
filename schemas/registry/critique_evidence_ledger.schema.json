{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathsciencecompendium.local/schemas/registry/critique_evidence_ledger.schema.json",
  "title": "CritiqueEvidenceLedger",
  "type": "object",
  "required": ["schema_version", "generator", "description", "claims"],
  "properties": {
    "schema_version": { "type": "integer", "enum": [1] },
    "generator": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "critique", "falsification_attempt", "status", "verdict", "evidence_paths"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "critique": { "type": "string", "minLength": 1 },
          "falsification_attempt": { "type": "string", "minLength": 1 },
          "status": {
            "type": "string",
            "enum": ["survives", "narrowed", "repaired", "falsified"]
          },
          "verdict": { "type": "string", "minLength": 1 },
          "evidence_paths": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
