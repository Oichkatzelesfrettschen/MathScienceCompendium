{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathsciencecompendium.local/schemas/registry/document_decomposition_audit.schema.json",
  "title": "DocumentDecompositionAudit",
  "type": "object",
  "required": ["schema_version", "generator", "run_manifest", "engine", "document_count", "page_count", "content_type_counts", "documents"],
  "properties": {
    "schema_version": { "type": "integer", "enum": [1] },
    "generator": { "type": "string", "minLength": 1 },
    "run_manifest": {
      "type": "object",
      "required": ["relpath", "sha256"],
      "properties": {
        "relpath": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "engine": {
      "type": "object",
      "required": ["name", "version", "backend", "effort", "mode", "formula", "table", "image_analysis"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "backend": { "type": "string", "minLength": 1 },
        "effort": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "minLength": 1 },
        "formula": { "type": "boolean" },
        "table": { "type": "boolean" },
        "image_analysis": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "document_count": { "type": "integer", "minimum": 0 },
    "page_count": { "type": "integer", "minimum": 0 },
    "content_type_counts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 1 }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_relpath", "source_sha256", "page_count", "markdown_relpath", "markdown_sha256", "markdown_bytes", "markdown_nonspace_characters", "content_list_relpath", "content_list_sha256", "content_item_count", "content_type_counts", "artifact_file_count", "artifact_bytes"],
        "properties": {
          "source_relpath": { "type": "string", "pattern": "\\.pdf$" },
          "source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "page_count": { "type": "integer", "minimum": 1 },
          "markdown_relpath": { "type": "string", "pattern": "\\.md$" },
          "markdown_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "markdown_bytes": { "type": "integer", "minimum": 0 },
          "markdown_nonspace_characters": { "type": "integer", "minimum": 0 },
          "content_list_relpath": { "type": "string", "pattern": "_content_list\\.json$" },
          "content_list_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "content_item_count": { "type": "integer", "minimum": 0 },
          "content_type_counts": {
            "type": "object",
            "additionalProperties": { "type": "integer", "minimum": 1 }
          },
          "artifact_file_count": { "type": "integer", "minimum": 1 },
          "artifact_bytes": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
