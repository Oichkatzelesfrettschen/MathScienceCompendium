{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathsciencecompendium.local/schemas/registry/manuscript_result_claims.schema.json",
  "title": "ManuscriptResultClaims",
  "type": "object",
  "required": ["schema_version", "description", "records"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "description": {"type": "string", "minLength": 1},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["hypothesis_id", "result_relpath", "section_relpaths"],
        "additionalProperties": false,
        "properties": {
          "hypothesis_id": {"type": "string", "pattern": "^hyp_[a-z0-9_]+$"},
          "result_relpath": {"type": "string", "pattern": "^data/(registry|reproduction)/[A-Za-z0-9._/-]+$"},
          "section_relpaths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^papers/(main\\.tex|sections/[A-Za-z0-9._/-]+\\.tex)$"}
          }
        }
      }
    }
  }
}
