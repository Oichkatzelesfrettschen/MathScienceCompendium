{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathsciencecompendium.local/schemas/registry/pdf_ocr_visual_review.schema.json",
  "title": "PDFOCRVisualReview",
  "type": "object",
  "required": ["schema_version", "review_method", "source_pdf", "reviewed_pages", "selection"],
  "properties": {
    "schema_version": { "type": "integer", "enum": [1] },
    "review_method": { "type": "string", "minLength": 1 },
    "source_pdf": {
      "type": "object",
      "required": ["relpath", "sha256"],
      "properties": {
        "relpath": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "reviewed_pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["page", "criteria", "note"],
        "properties": {
          "page": { "type": "integer", "minimum": 1 },
          "criteria": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "required": ["mineru", "tesseract"],
              "properties": {
                "mineru": { "type": "string", "enum": ["pass", "partial", "fail"] },
                "tesseract": { "type": "string", "enum": ["pass", "partial", "fail"] }
              },
              "additionalProperties": false
            }
          },
          "note": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "selection": {
      "type": "object",
      "required": ["primary", "fallback", "basis"],
      "properties": {
        "primary": { "type": "string", "minLength": 1 },
        "fallback": { "type": "string", "minLength": 1 },
        "basis": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
