{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathsciencecompendium.local/schemas/registry/experiments_index.schema.json",
  "title": "ExperimentsIndexRegistry",
  "type": "object",
  "required": ["generated_by", "generated_at_utc", "experiments"],
  "properties": {
    "generated_by": { "type": "string", "minLength": 1 },
    "generated_at_utc": { "type": "string", "format": "date-time" },
    "experiments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "relpath", "sha256", "size_bytes"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "relpath": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "size_bytes": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
