{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathsciencecompendium.local/schemas/artifact_entry.schema.json",
  "title": "ArtifactEntry",
  "type": "object",
  "required": ["relpath", "kind", "size_bytes", "sha256"],
  "properties": {
    "relpath": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "minLength": 1 },
    "size_bytes": { "type": "integer", "minimum": 0 },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
